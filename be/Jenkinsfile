pipeline {
    agent any

    environment {
        IMAGE_NAME = "a405-backend:latest"
        CONTAINER_NAME = "a405-backend"
        APP_PORT = "8080"
        SHOULD_DEPLOY = "false"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    echo "BRANCH_NAME=${env.BRANCH_NAME}"

                    if (env.BRANCH_NAME == 'develop') {
                        def changed = sh(
                            script: "git diff --name-only HEAD~1 HEAD | grep '^be/' || true",
                            returnStdout: true
                        ).trim()

                        if (changed) {
                            env.SHOULD_DEPLOY = "true"
                        }
                    }
                }
            }
        }

        stage('CI Build/Test') {
            when {
                expression {
                    return env.BRANCH_NAME != null && env.BRANCH_NAME.contains('/be/')
                }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'prod-db-url', variable: 'PROD_DB_URL'),
                    string(credentialsId: 'prod-db-username', variable: 'PROD_DB_USERNAME'),
                    string(credentialsId: 'prod-db-password', variable: 'PROD_DB_PASSWORD')
                ]) {
                    dir('be') {
                        sh '''
                            docker build \
                              --build-arg SPRING_PROFILES_ACTIVE=prod \
                              --build-arg PROD_DB_URL="$PROD_DB_URL" \
                              --build-arg PROD_DB_USERNAME="$PROD_DB_USERNAME" \
                              --build-arg PROD_DB_PASSWORD="$PROD_DB_PASSWORD" \
                              -t ${IMAGE_NAME} .
                        '''
                    }
                }
            }
        }

        stage('CD Build') {
            when {
                expression {
                    return env.BRANCH_NAME == 'develop' && env.SHOULD_DEPLOY == 'true'
                }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'prod-db-url', variable: 'PROD_DB_URL'),
                    string(credentialsId: 'prod-db-username', variable: 'PROD_DB_USERNAME'),
                    string(credentialsId: 'prod-db-password', variable: 'PROD_DB_PASSWORD')
                ]) {
                    dir('be') {
                        sh '''
                            docker build \
                              --build-arg SPRING_PROFILES_ACTIVE=prod \
                              --build-arg PROD_DB_URL="$PROD_DB_URL" \
                              --build-arg PROD_DB_USERNAME="$PROD_DB_USERNAME" \
                              --build-arg PROD_DB_PASSWORD="$PROD_DB_PASSWORD" \
                              -t ${IMAGE_NAME} .
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                expression {
                    return env.BRANCH_NAME == 'develop' && env.SHOULD_DEPLOY == 'true'
                }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'prod-db-url', variable: 'PROD_DB_URL'),
                    string(credentialsId: 'prod-db-username', variable: 'PROD_DB_USERNAME'),
                    string(credentialsId: 'prod-db-password', variable: 'PROD_DB_PASSWORD')
                ]) {
                    sh '''
                        docker rm -f ${CONTAINER_NAME} || true
                        docker run -d \
                          --name ${CONTAINER_NAME} \
                          -p ${APP_PORT}:8080 \
                          -e SPRING_PROFILES_ACTIVE=prod \
                          -e PROD_DB_URL="$PROD_DB_URL" \
                          -e PROD_DB_USERNAME="$PROD_DB_USERNAME" \
                          -e PROD_DB_PASSWORD="$PROD_DB_PASSWORD" \
                          ${IMAGE_NAME}
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'BE pipeline success'
        }
        failure {
            echo 'BE pipeline failed'
        }
    }
}