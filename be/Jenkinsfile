pipeline {
    agent any

    environment {
        IMAGE_NAME = "a405-backend:latest"
        CONTAINER_NAME = "a405-backend"
        APP_PORT = "8080"
        SHOULD_DEPLOY = "false"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    echo "BRANCH_NAME=${env.BRANCH_NAME}"

                    if (env.BRANCH_NAME == 'develop') {
                        def changed = sh(
                            script: "git diff --name-only HEAD~1 HEAD | grep '^be/' || true",
                            returnStdout: true
                        ).trim()

                        if (changed) {
                            env.SHOULD_DEPLOY = "true"
                        }

                        echo "BE changed files:"
                        echo changed ?: "(none)"
                        echo "SHOULD_DEPLOY=${env.SHOULD_DEPLOY}"
                    }
                }
            }
        }

        stage('CI Build/Test') {
            when {
                expression {
                    return env.BRANCH_NAME != null && env.BRANCH_NAME.contains('/be/')
                }
            }
            steps {
                dir('be') {
                    sh 'docker build -t ${IMAGE_NAME} .'
                }
            }
        }

        stage('CD Build') {
            when {
                expression {
                    return env.BRANCH_NAME == 'develop' && env.SHOULD_DEPLOY == 'true'
                }
            }
            steps {
                dir('be') {
                    sh 'docker build -t ${IMAGE_NAME} .'
                }
            }
        }

        stage('Deploy') {
            when {
                expression {
                    return env.BRANCH_NAME == 'develop' && env.SHOULD_DEPLOY == 'true'
                }
            }
            steps {
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true
                    docker run -d \
                      --name ${CONTAINER_NAME} \
                      -p ${APP_PORT}:8080 \
                      ${IMAGE_NAME}
                '''
            }
        }
    }

    post {
        success {
            echo 'BE pipeline success'
        }
        failure {
            echo 'BE pipeline failed'
        }
    }
}