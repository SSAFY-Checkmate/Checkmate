pipeline {
    agent any

    environment {
        IMAGE_NAME = "a405-backend:latest"
        NETWORK_NAME = "checkmate-net"
        COMPOSE_FILE = "be/docker-compose.prod.yml"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    echo "BRANCH_NAME=${env.BRANCH_NAME}"

                    if (env.BRANCH_NAME == 'develop') {
                        def changed = sh(
                            script: "git diff --name-only HEAD~1 HEAD || true",
                            returnStdout: true
                        ).trim()

                        def beChanged = sh(
                            script: "git diff --name-only HEAD~1 HEAD | grep '^be/' || true",
                            returnStdout: true
                        ).trim()

                        echo "CHANGED_FILES=${changed}"
                        echo "BE_CHANGED_FILES=${beChanged}"
                    }
                }
            }
        }

        stage('Docker Build') {
            when {
                expression {
                    return env.BRANCH_NAME == 'develop' &&
                           sh(
                               script: "git diff --name-only HEAD~1 HEAD | grep '^be/' || true",
                               returnStdout: true
                           ).trim()
                }
            }
            steps {
                dir('be') {
                    sh '''
                        docker build -t ${IMAGE_NAME} .
                    '''
                }
            }
        }

        stage('Deploy') {
            when {
                branch 'develop'
            }
            steps {
                withCredentials([
                    string(credentialsId: 'prod-db-url', variable: 'PROD_DB_URL'),
                    string(credentialsId: 'prod-db-username', variable: 'PROD_DB_USERNAME'),
                    string(credentialsId: 'prod-db-password', variable: 'PROD_DB_PASSWORD'),
                    string(credentialsId: 'jwt-secret', variable: 'JWT_SECRET'),
                    string(credentialsId: 'google-client-id', variable: 'GOOGLE_CLIENT_ID'),
                    string(credentialsId: 'google-client-secret', variable: 'GOOGLE_CLIENT_SECRET'),
                    string(credentialsId: 'oauth2-success-redirect-uri', variable: 'OAUTH2_SUCCESS_REDIRECT_URI')
                ]) {
                    sh '''
                        # 1. checkmate-net 네트워크 보장
                        docker network inspect ${NETWORK_NAME} >/dev/null 2>&1 || docker network create ${NETWORK_NAME}

                        # 2. Jenkins 컨테이너도 같은 네트워크에 연결
                        docker network connect ${NETWORK_NAME} jenkins || true

                        # 3. compose에서 사용할 운영 환경변수 export
                        export PROD_DB_URL="$PROD_DB_URL"
                        export PROD_DB_USERNAME="$PROD_DB_USERNAME"
                        export PROD_DB_PASSWORD="$PROD_DB_PASSWORD"
                        export JWT_SECRET="$JWT_SECRET"
                        export GOOGLE_CLIENT_ID="$GOOGLE_CLIENT_ID"
                        export GOOGLE_CLIENT_SECRET="$GOOGLE_CLIENT_SECRET"
                        export OAUTH2_SUCCESS_REDIRECT_URI="$OAUTH2_SUCCESS_REDIRECT_URI"

                        # 4. docker-compose.prod.yml 기준으로 컨테이너 실행
                        docker compose -f ${COMPOSE_FILE} up -d
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            when {
                branch 'develop'
            }
            steps {
                sh '''
                    echo "Waiting for containers to stabilize..."
                    sleep 40

                    BACKEND_STATUS=$(docker inspect -f '{{.State.Running}}' a405-backend 2>/dev/null || echo "false")
                    PUBLISHER_STATUS=$(docker inspect -f '{{.State.Running}}' a405-backend-publisher 2>/dev/null || echo "false")
                    REDIS_STATUS=$(docker inspect -f '{{.State.Running}}' redis 2>/dev/null || echo "false")
                    KAFKA_STATUS=$(docker inspect -f '{{.State.Running}}' kafka 2>/dev/null || echo "false")
                    ZOOKEEPER_STATUS=$(docker inspect -f '{{.State.Running}}' zookeeper 2>/dev/null || echo "false")

                    echo "a405-backend running: ${BACKEND_STATUS}"
                    echo "a405-backend-publisher running: ${PUBLISHER_STATUS}"
                    echo "redis running: ${REDIS_STATUS}"
                    echo "kafka running: ${KAFKA_STATUS}"
                    echo "zookeeper running: ${ZOOKEEPER_STATUS}"

                    if [ "$BACKEND_STATUS" != "true" ]; then
                      echo "[ERROR] Backend container is not running"
                      docker logs --tail 100 a405-backend || true
                      exit 1
                    fi

                    if [ "$REDIS_STATUS" != "true" ]; then
                      echo "[ERROR] Redis container is not running"
                      docker logs --tail 100 redis || true
                      exit 1
                    fi

                    if [ "$KAFKA_STATUS" != "true" ]; then
                      echo "[ERROR] Kafka container is not running"
                      docker logs --tail 100 kafka || true
                      exit 1
                    fi

                    echo "Checking backend HTTP response via Docker Network..."
                    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://a405-backend:8080/health || echo "000")
                    echo "Backend responded with HTTP CODE: $HTTP_CODE"

                    if [ "$HTTP_CODE" -eq 200 ]; then
                      echo "Health check passed"
                    else
                      echo "[ERROR] Health check failed with code $HTTP_CODE"
                      docker logs --tail 100 a405-backend || true
                      exit 1
                    fi

                    echo "Checking checkmate-net containers..."
                    docker network inspect checkmate-net --format '{{range .Containers}}{{.Name}} {{end}}'
                '''
            }
        }
    }

    post {
        success {
            echo 'BE pipeline success'
        }
        failure {
            echo 'BE pipeline failed'
        }
    }
}