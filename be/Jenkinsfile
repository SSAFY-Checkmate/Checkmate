pipeline {
    agent any

    environment {
        IMAGE_NAME = "a405-backend:latest"
        CONTAINER_NAME = "a405-backend"
        APP_PORT = "8080"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'echo BRANCH_NAME=$BRANCH_NAME'
            }
        }

        stage('Build Backend Image') {
            when {
                expression {
                    return env.BRANCH_NAME == 'develop' || env.BRANCH_NAME.contains('/be/')
                }
            }
            steps {
                dir('be') {
                    sh 'docker build -t ${IMAGE_NAME} .'
                }
            }
        }

        stage('Check BE Changes') {
            when {
                branch 'develop'
            }
            steps {
                script {
                    def changed = sh(
                        script: "git diff --name-only HEAD~1 HEAD | grep '^be/' || true",
                        returnStdout: true
                    ).trim()

                    env.BE_CHANGED = changed ? "true" : "false"
                    echo "BE_CHANGED=${env.BE_CHANGED}"
                }
            }
        }

        stage('Deploy Backend') {
            when {
                expression {
                    return env.BRANCH_NAME == 'develop' && env.BE_CHANGED == 'true'
                }
            }
            steps {
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true
                    docker run -d \
                      --name ${CONTAINER_NAME} \
                      -p ${APP_PORT}:8080 \
                      ${IMAGE_NAME}
                '''
            }
        }
    }

    post {
        success {
            echo 'BE pipeline success'
        }
        failure {
            echo 'BE pipeline failed'
        }
    }
}