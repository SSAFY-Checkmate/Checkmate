pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "a405-frontend"
        NETWORK_NAME = "checkmate-net"
        VITE_API_URL = "http://k14a405.p.ssafy.io/be"
        HOST_IP = "172.26.5.216"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code...'
                checkout scm
            }
        }

        stage('Detect FE Changes') {
            when {
                branch 'develop'
            }
            steps {
                script {
                    def changedFiles = sh(
                        script: 'git diff --name-only HEAD~1 HEAD || true',
                        returnStdout: true
                    ).trim()

                    echo "Changed files:\n${changedFiles}"

                    def feChanged = sh(
                        script: "git diff --name-only HEAD~1 HEAD | grep '^fe/' || true",
                        returnStdout: true
                    ).trim()

                    if (!feChanged) {
                        echo 'No FE changes detected in develop. Skipping FE deploy stages.'
                        env.SKIP_FE_DEPLOY = "true"
                    } else {
                        env.SKIP_FE_DEPLOY = "false"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            when {
                expression {
                    return env.BRANCH_NAME != 'develop' || env.SKIP_FE_DEPLOY != "true"
                }
            }
            steps {
                dir('fe') {
                    sh '''
                        set -e

                        docker rmi ${DOCKER_IMAGE}:latest || true

                        docker build --no-cache \
                          --build-arg VITE_API_URL=${VITE_API_URL} \
                          -t ${DOCKER_IMAGE}:latest .
                    '''
                }
            }
        }

        stage('Deploy Blue-Green') {
            when {
                allOf {
                    branch 'develop'
                    expression { env.SKIP_FE_DEPLOY != "true" }
                }
            }
            steps {
                sshagent(credentials: ['host-ssh-key']) {
                    sh '''
                        set -e

                        # Blue-Green 스크립트를 host 서버로 복사
                        scp -o StrictHostKeyChecking=no \
                          fe/deploy-frontend-bluegreen.sh \
                          ubuntu@${HOST_IP}:/home/ubuntu/deploy-frontend-bluegreen.sh

                        # host 서버에서 Blue-Green 배포 실행
                        ssh -o StrictHostKeyChecking=no ubuntu@${HOST_IP} bash <<'EOF'
chmod +x /home/ubuntu/deploy-frontend-bluegreen.sh
bash /home/ubuntu/deploy-frontend-bluegreen.sh
EOF
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            when {
                allOf {
                    branch 'develop'
                    expression { env.SKIP_FE_DEPLOY != "true" }
                }
            }
            steps {
                sshagent(credentials: ['host-ssh-key']) {
                    sh '''
                        set -e

                        echo "Waiting for frontend containers to stabilize..."
                        sleep 5

                        ssh -o StrictHostKeyChecking=no ubuntu@${HOST_IP} bash <<'EOF'
set -e

ACTIVE_COLOR=$(cat /home/ubuntu/frontend-active-color)
FRONTEND_CONTAINER="a405-frontend-${ACTIVE_COLOR}"

FRONTEND_STATUS=$(docker inspect -f '{{.State.Running}}' ${FRONTEND_CONTAINER} 2>/dev/null || echo "false")

echo "${FRONTEND_CONTAINER} running: ${FRONTEND_STATUS}"

if [ "$FRONTEND_STATUS" != "true" ]; then
  echo "[ERROR] Frontend container is not running"
  docker logs --tail 100 ${FRONTEND_CONTAINER} || true
  exit 1
fi

echo "Checking frontend HTTP response via Nginx..."
HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" https://k14a405.p.ssafy.io/ || echo "000")
echo "Frontend responded with HTTP CODE: $HTTP_CODE"

if [ "$HTTP_CODE" = "200" ] || [ "$HTTP_CODE" = "304" ]; then
  echo "Frontend health check passed"
else
  echo "[ERROR] Frontend health check failed with code $HTTP_CODE"
  docker logs --tail 100 ${FRONTEND_CONTAINER} || true
  exit 1
fi

echo "Checking frontend active color..."
cat /home/ubuntu/frontend-active-color

echo "Checking frontend upstream..."
sudo cat /etc/nginx/conf.d/frontend-upstream.conf

echo "Checking frontend containers..."
docker ps --format "table {{.Names}}\\t{{.Ports}}" | grep a405-frontend
EOF
                    '''
                }
            }
        }

        stage('Cleanup Old Images') {
            when {
                allOf {
                    branch 'develop'
                    expression { env.SKIP_FE_DEPLOY != "true" }
                }
            }
            steps {
                sh '''
                    docker image prune -f
                '''
            }
        }
    }

    post {
        success {
            echo "FE pipeline success! (Build: ${env.BUILD_NUMBER})"
        }
        failure {
            echo "FE pipeline failed!"
        }
    }
}