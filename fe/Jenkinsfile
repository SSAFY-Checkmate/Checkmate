pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "a405-frontend"
        CONTAINER_NAME = "a405-frontend"
        HOST_PORT = "3000"
        VITE_API_URL = "http://k14a405.p.ssafy.io/be"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code...'
                checkout scm
            }
        }

        stage('Detect FE Changes') {
            when { branch 'develop' }
            steps {
                script {
                    def changedFiles = sh(
                        script: 'git diff --name-only HEAD~1 HEAD || true',
                        returnStdout: true
                    ).trim()

                    echo "Changed files:\n${changedFiles}"

                    def feChanged = sh(
                        script: "git diff --name-only HEAD~1 HEAD | grep '^fe/' || true",
                        returnStdout: true
                    ).trim()

                    if (!feChanged) {
                        echo 'No FE changes detected in develop. Skipping FE deploy stages.'
                        env.SKIP_FE_DEPLOY = "true"
                    } else {
                        env.SKIP_FE_DEPLOY = "false"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            when {
                expression {
                    return env.BRANCH_NAME != 'develop' || env.SKIP_FE_DEPLOY != "true"
                }
            }
            steps {
                script {
                    dir('fe') {
                        sh "docker rmi ${DOCKER_IMAGE}:${BUILD_NUMBER} || true"
                        sh """
                            docker build --no-cache \
                            --build-arg VITE_API_URL=${VITE_API_URL} \
                            -t ${DOCKER_IMAGE}:${BUILD_NUMBER} .
                        """
                    }
                }
            }
        }

        stage('Stop Old Container') {
            when {
                allOf {
                    branch 'develop'
                    expression { env.SKIP_FE_DEPLOY != "true" }
                }
            }
            steps {
                sh "docker stop ${CONTAINER_NAME} || true"
                sh "docker rm ${CONTAINER_NAME} || true"
            }
        }

        stage('Deploy') {
            when {
                allOf {
                    branch 'develop'
                    expression { env.SKIP_FE_DEPLOY != "true" }
                }
            }
            steps {
                sh """
                    docker run -d \
                    --name ${CONTAINER_NAME} \
                    -p ${HOST_PORT}:80 \
                    --restart unless-stopped \
                    ${DOCKER_IMAGE}:${BUILD_NUMBER}
                """
            }
        }

        stage('Health Check') {
            when {
                allOf {
                    branch 'develop'
                    expression { env.SKIP_FE_DEPLOY != "true" }
                }
            }
            steps {
                retry(5) {
                    sleep(time: 5, unit: 'SECONDS')
                    sh "curl -f http://127.0.0.1:${HOST_PORT}"
                }
            }
        }

        stage('Cleanup Old Images') {
            when {
                allOf {
                    branch 'develop'
                    expression { env.SKIP_FE_DEPLOY != "true" }
                }
            }
            steps {
                sh 'docker image prune -f'
            }
        }
    }

    post {
        success {
            echo "FE deployment successful! (Build: ${env.BUILD_NUMBER})"
        }
        failure {
            echo "FE deployment failed!"
        }
    }
}