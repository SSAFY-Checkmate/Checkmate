pipeline {
    agent any

    environment {
        IMAGE_NAME = "a405-parser:latest"
        CONTAINER_NAME = "a405-parser"
        HOST_PORT = "8089"
        CONTAINER_PORT = "8000"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    echo "BRANCH_NAME=${env.BRANCH_NAME}"

                    def changed = sh(
                        script: "git diff --name-only HEAD~1 HEAD || true",
                        returnStdout: true
                    ).trim()

                    def parserChanged = sh(
                        script: "git diff --name-only HEAD~1 HEAD | grep '^parser/' || true",
                        returnStdout: true
                    ).trim()

                    echo "Changed files:"
                    echo changed

                    env.PARSER_CHANGED = parserChanged ? "true" : "false"

                    echo "PARSER_CHANGED=${env.PARSER_CHANGED}"
                }
            }
        }

        stage('Skip Check') {
            when {
                expression {
                    return env.PARSER_CHANGED != "true"
                }
            }
            steps {
                echo "parser/** 변경 사항이 없으므로 Parser build/deploy를 skip합니다."
            }
        }

        stage('Build Docker Image') {
            when {
                expression {
                    return env.PARSER_CHANGED == "true"
                }
            }
            steps {
                script {
                    sh """
                        docker build -t ${IMAGE_NAME} ./parser
                    """
                }
            }
        }

        stage('Deploy Parser') {
            when {
                allOf {
                    branch 'develop'
                    expression {
                        return env.PARSER_CHANGED == "true"
                    }
                }
            }
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'GMS_KEY', variable: 'GMS_KEY')
                    ]) {
                        sh """
                            docker stop ${CONTAINER_NAME} || true
                            docker rm ${CONTAINER_NAME} || true

                            docker run -d \\
                              --name ${CONTAINER_NAME} \\
                              -p ${HOST_PORT}:${CONTAINER_PORT} \\
                              -e GMS_KEY="${GMS_KEY}" \\
                              --restart unless-stopped \\
                              ${IMAGE_NAME}
                        """
                    }
                }
            }
        }

        stage('Health Check') {
            when {
                allOf {
                    branch 'develop'
                    expression {
                        return env.PARSER_CHANGED == "true"
                    }
                }
            }
            steps {
                script {
                    sh """
                        sleep 5
                        curl -f http://localhost:${HOST_PORT}/health
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Parser pipeline completed successfully."
        }

        failure {
            echo "Parser pipeline failed."
            sh """
                docker logs --tail 100 ${CONTAINER_NAME} || true
            """
        }
    }
}